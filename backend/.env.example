# Copy this file to `.env` in the backend/ folder and fill in your real
# MySQL credentials. The server reads it automatically on startup (via
# python-dotenv). If MySQL isn't reachable with these settings, the app
# falls back to a local SQLite file (backend/ems.db) so it still runs.

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=ems

# Alternative: set this instead of the five DB_* vars above to point at any
# SQLAlchemy-compatible database (Postgres, a remote MySQL host, etc).
# Takes priority over DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_NAME when set.
# DATABASE_URL=mysql+pymysql://user:password@host:3306/ems
